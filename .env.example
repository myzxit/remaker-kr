# ─── 기본 ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
AUTH_SECRET="openssl rand -base64 32 로 만든 값"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
STORAGE_DIR="./storage"

# ─── 소셜 로그인 (선택) ──────────────────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── 음성 인식 ───────────────────────────────────────────────────────────
WHISPER_MODEL="small"          # tiny / base / small / medium / large-v3
WHISPER_DEVICE="cpu"           # cpu | cuda
WHISPER_COMPUTE_TYPE="int8"    # int8 | float16
WHISPER_LANGUAGE="ko"          # 빈 값이면 자동 감지

# ─── 음성 합성 ───────────────────────────────────────────────────────────
# edge-tts 를 씁니다. API 키가 필요 없습니다.
EDGE_TTS_PATH="edge-tts"

# ─── 영상 처리 ───────────────────────────────────────────────────────────
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
YTDLP_PATH="yt-dlp"
PYTHON_PATH="python3"
FFMPEG_PRESET="veryfast"
FFMPEG_CRF="21"
SUBTITLE_FONT="NanumGothic"
SUBTITLE_FONT_DIR=""           # 시스템에 한글 글꼴이 없을 때 글꼴 폴더 경로

# ─── 선택 도구 ───────────────────────────────────────────────────────────
# 이미지 생성 엔진(ComfyUI · Automatic1111) 주소. 없으면 해당 도구가 꺼집니다.
IMAGE_API_URL=""
# 유튜브 데이터 API 키. 없으면 트렌드 도구가 꺼집니다.
YOUTUBE_API_KEY=""

# ─── 워커 ────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY="1"
WORKER_POLL_MS="3000"
